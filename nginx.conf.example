# ============================================================
# Configuración Nginx recomendada para Subastas Insignia (VPS)
# Ubicación habitual: /etc/nginx/sites-available/insignia
# Enlace simbólico: sudo ln -s /etc/nginx/sites-available/insignia /etc/nginx/sites-enabled/
# ============================================================

server {
    listen 80;
    server_name subastasinsignia.com.ar www.subastasinsignia.com.ar;

    # Directorio de los archivos estáticos de React (resultado de 'npm run build')
    root /var/www/insignia/dist;
    index index.html;

    # Compresión Gzip para carga ultra rápida
    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types text/plain text/css text/xml application/json application/javascript application/rss+xml application/atom+xml image/svg+xml;

    # Cabeceras de seguridad globales
    add_header X-Frame-Options "SAMEORIGIN" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-XSS-Protection "1; mode=block" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Servir archivos estáticos del frontend con soporte para SPA (React Router)
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Caché agresivo para assets compilados con hash (JS, CSS, imágenes)
    location ~* \.(?:ico|css|js|gif|jpe?g|png|webp|svg|woff2?|eot|ttf|otf)$ {
        expires 6M;
        access_log off;
        add_header Cache-Control "public, max-age=15552000, immutable";
        try_files $uri =404;
    }

    # Proxy hacia el Backend API (Docker Node.js en puerto 4800)
    location /api/ {
        proxy_pass http://127.0.0.1:4800/api/;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;

        # Límite de subida de imágenes (15MB)
        client_max_body_size 15M;
    }

    # Proxy hacia las fotos subidas dinámicamente desde el panel
    # ^~ hace que esta regla gane sobre la de cache de imagenes (.jpg/.png), si no las fotos dan 404
    location ^~ /uploads/ {
        proxy_pass http://127.0.0.1:4800/uploads/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        client_max_body_size 15M;
    }

    # Bloqueo de acceso a archivos ocultos (.git, .env)
    location ~ /\. {
        deny all;
        access_log off;
        log_not_found off;
    }
}
